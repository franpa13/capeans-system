# Copiá este archivo a .env en el servidor y completá cada valor.
# Nunca lo subas a git (.env está ignorado).

# Contraseña de la base de datos: larga y aleatoria, por ejemplo la salida de
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Claves de Clerk (dashboard.clerk.com → tu aplicación de PRODUCCIÓN).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Puerto donde escucha la app en el servidor (detrás de un proxy con HTTPS).
APP_PORT=3000

# Copias de seguridad: hora del día (0-23) y cuántos días se conservan.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
TZ=America/Argentina/Buenos_Aires
