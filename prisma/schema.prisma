generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  createdAt  DateTime @default(now())

  patients      Patient[]
  consultations Consultation[]
  appointments  Appointment[]
  options       ClinicOption[]
  businessHours BusinessHours[]
}

model Patient {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name      String
  phone     String
  email     String?
  dni       String?
  birthDate DateTime?
  address   String?
  insurance String?
  allergies String?

  consultations Consultation[]
  appointments  Appointment[]

  @@index([clinicId])
}

model Consultation {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  date      DateTime
  treatment String
  teeth     String[] @default([])
  notes     String?

  @@index([clinicId])
  @@index([patientId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String?
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)

  startsAt        DateTime
  durationMinutes Int               @default(30)
  reason          String?
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  createdAt       DateTime          @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, startsAt])
}

model BusinessHours {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // JS Date.getDay() convention (see appointments/lib/week.ts): 0=Sunday,
  // 1=Monday .. 6=Saturday. Only 1..6 are ever configured/rendered — the
  // weekly calendar never shows a Sunday column.
  weekday Int

  isOpen Boolean @default(true)

  // "HH:mm", 24h local time. Null when the day is closed.
  openTime1  String?
  closeTime1 String?
  // Optional second shift, for a clinic that closes for lunch — both null
  // when unused.
  openTime2  String?
  closeTime2 String?

  @@unique([clinicId, weekday])
  @@index([clinicId])
}

model ClinicOption {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  category String
  label    String
  order    Int    @default(0)

  @@unique([clinicId, category, label])
  @@index([clinicId, category])
}
