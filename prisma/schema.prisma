generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  createdAt  DateTime @default(now())
  // Shown on printed recetas, under the clinic's name.
  address    String?
  phone      String?
  email      String?

  patients      Patient[]
  consultations Consultation[]
  appointments  Appointment[]
  options       ClinicOption[]
  businessHours BusinessHours[]
  supplies      Supply[]
  payments      Payment[]
  patientFiles  PatientFile[]
  patientNotes  PatientNote[]
  toothFindings ToothFinding[]
  timeBlocks    TimeBlock[]
  professionals Professional[]
  prescriptions Prescription[]
  medicalOrders MedicalOrder[]
}

model Patient {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // `name` is the full name every list, search and export shows; it's kept
  // equal to firstName + lastName by the data layer.
  name      String
  firstName String    @default("")
  lastName  String    @default("")
  phone     String
  email     String?
  dni       String?
  birthDate DateTime?
  address   String?
  insurance String?
  // N° de afiliado de la obra social, needed to bill it.
  insuranceNumber String?
  allergies String?
  // Keys from MEDICAL_CONDITIONS (lib/medical.ts), e.g. "anticoagulantes".
  medicalConditions String[] @default([])
  medications String?

  // Datos personales
  gender    String?
  active    Boolean @default(true)
  city      String?
  province  String?

  // Obra social (beyond insurance / insuranceNumber)
  insurancePlan       String?
  insuranceHolder     String? // titular, when it isn't the patient
  holderRelationship  String? // parentesco con el titular
  familyGroup         String?
  holderWorkplace     String?

  // Datos fiscales (to invoice)
  taxId        String? // CUIT / CUIL
  taxName      String? // razón social, if different from the patient's name
  ivaCondition String?

  // Contacto de emergencia
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Información médica (beyond allergies / conditions / medications)
  bloodType      String?
  bloodPressure  String?
  medicalHistory String? // antecedentes, free text

  // Notas y origen
  referralSource   String?
  acceptsReminders Boolean @default(true)
  // Superseded by PatientNote (observaciones); its text was moved there.
  internalNotes    String?

  consultations Consultation[]
  appointments  Appointment[]
  files         PatientFile[]
  notes         PatientNote[]
  toothFindings ToothFinding[]
  prescriptions Prescription[]
  medicalOrders MedicalOrder[]

  @@index([clinicId])
}

model Consultation {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  date      DateTime
  treatment String
  teeth     String[] @default([])
  notes     String?

  amountCharged Int?            // monto acordado para esta visita (snapshot, no referencia viva al precio de lista)
  amountPaid    Int  @default(0) // cuánto se pagó hasta ahora

  // Turno del que viene esta consulta (opcional — una consulta sin turno,
  // ej. una urgencia, sigue siendo válida). Único: un turno se vincula a
  // una sola consulta. Borrar el turno no borra la consulta.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  supplyUsages ConsultationSupply[]
  // Each payment towards amountCharged; amountPaid above is kept equal to
  // their sum by the data layer, so balances and filters can read it alone.
  payments     Payment[]
  resolvedFindings ToothFinding[]

  @@index([clinicId])
  @@index([patientId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW // el paciente no vino
  WAITING // llegó: en sala de espera
}

model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String?
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)

  startsAt        DateTime
  durationMinutes Int               @default(30)
  reason          String?
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  createdAt       DateTime          @default(now())
  // When a WhatsApp reminder went out for this turno (today a one-tap
  // wa.me link; later possibly an automatic send) — null = not sent yet.
  reminderSentAt  DateTime?

  consultation    Consultation?

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, startsAt])
}

model BusinessHours {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // JS Date.getDay() convention (see appointments/lib/week.ts): 0=Sunday,
  // 1=Monday .. 6=Saturday. Only 1..6 are ever configured/rendered — the
  // weekly calendar never shows a Sunday column.
  weekday Int

  isOpen Boolean @default(true)

  // "HH:mm", 24h local time. Null when the day is closed.
  openTime1  String?
  closeTime1 String?
  // Optional second shift, for a clinic that closes for lunch — both null
  // when unused.
  openTime2  String?
  closeTime2 String?

  @@unique([clinicId, weekday])
  @@index([clinicId])
}

model ClinicOption {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  category String
  label    String
  order    Int    @default(0)
  price    Int?   // precio de lista, pesos enteros. Solo aplica a category == "treatment".

  // Only for category == "treatment":
  cashPrice       Int?    // precio en efectivo, pesos enteros
  code            String? // código de nomenclador, e.g. "12.04.00"
  specialty       String? // label of a "specialty" option
  durationMinutes Int?    // suggested length of a turno for it
  active          Boolean @default(true)

  @@unique([clinicId, category, label])
  @@index([clinicId, category])
}

model Supply {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name       String
  unit       String  // "unidad", "caja", "ml", etc. — texto libre
  price      Int?    // costo por unidad, pesos enteros (opcional)
  quantity   Int     @default(0)  // stock actual; puede quedar negativo
  lowStockAt Int?    // umbral de aviso, en la misma unidad (opcional)

  usages ConsultationSupply[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model ConsultationSupply {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  supplyId       String
  supply         Supply       @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  quantityUsed Int   // cuánto se usó en ESTA consulta

  @@index([consultationId])
  @@index([supplyId])
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

/// One payment towards a consulta (a full payment, or one installment).
model Payment {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consultationId String
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  amount    Int
  method    PaymentMethod @default(EFECTIVO)
  paidAt    DateTime
  createdAt DateTime      @default(now())

  @@index([clinicId, paidAt])
  @@index([consultationId])
}

/// A radiografía, foto or PDF attached to a patient. The bytes live on disk
/// (lib/file-storage.ts) under `storageKey`; this row is what's listed.
model PatientFile {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([clinicId, patientId])
}

/// A period with no turnos (vacaciones, feriado, congreso…): shown on the
/// agenda, and turnos can't be booked inside it.
model TimeBlock {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([clinicId, startsAt])
}

/// An observación on a patient's ficha: dated, with who wrote it.
model PatientNote {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  text       String
  // The Clerk user's name when it was written; null if unknown.
  authorName String?
  createdAt  DateTime @default(now())

  @@index([clinicId, patientId])
}

enum FindingStatus {
  PENDING // a realizar — red on the odontograma
  DONE // realizado or already there — blue
}

/// A hallazgo on the odontograma: a condition on one surface of a tooth
/// (caries, restauración…) or on the whole tooth (surface null: corona,
/// ausente…). Keys and labels live in lib/findings.ts.
model ToothFinding {
  id         String        @id @default(cuid())
  clinicId   String
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  tooth      String // FDI, e.g. "16"
  surface    String? // V, M, O, D, L
  condition  String
  status     FindingStatus
  notes      String?
  authorName String?
  createdAt  DateTime      @default(now())
  // When it was done, and by which consulta if one resolved it.
  resolvedAt     DateTime?
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId])
}

/// A dentist of the clinic: who signs recetas.
model Professional {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  title     String // "Dr.", "Dra." or "Od."
  name      String
  specialty String?
  license   String // matrícula, e.g. "MP 4123"
  // The drawn signature, a PNG data URL.
  signature String?
  createdAt DateTime @default(now())

  prescriptions Prescription[]
  medicalOrders MedicalOrder[]

  @@index([clinicId])
}

/// A receta. The professional's name, matrícula and signature are copied
/// in when it's issued, so later edits to their profile don't rewrite it.
model Prescription {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  // Per clinic, from 1: printed as REC-00000001.
  number    Int
  date      DateTime @default(now())
  treatment String?
  // [{ drug, concentration, quantity, instructions }]
  items        Json
  instructions String?

  professionalTitle     String
  professionalName      String
  professionalSpecialty String?
  professionalLicense   String
  professionalSignature String?
  createdAt DateTime @default(now())

  @@unique([clinicId, number])
  @@index([clinicId, patientId])
}

/// An orden: imaging studies, lab tests or a referral the dentist asks
/// for. Like a receta, it keeps its professional as they were when issued.
model MedicalOrder {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  // Per clinic, from 1: printed as ORD-00000001.
  number    Int
  date      DateTime @default(now())
  kind      String // lib/orders.ts: imagenes, laboratorio, derivacion
  // What's asked for, one line each.
  items     String[]
  diagnosis String?
  notes     String?

  professionalTitle     String
  professionalName      String
  professionalSpecialty String?
  professionalLicense   String
  professionalSignature String?
  createdAt DateTime @default(now())

  @@unique([clinicId, number])
  @@index([clinicId, patientId])
}
